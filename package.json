{
  "name": "image-crawler",
  "version": "1.0.0",
  "type": "module",
  "description": "Cross-platform image collection tool with local and web crawling capabilities",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js interactive",
    "electron:start": "electron .",
    "test": "npx playwright test",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "prepare": "husky install",
    "electron:dev": "electron . --inspect"
  },
  "bin": {
    "image-crawler": "./src/index.js"
  },
  "keywords": [
    "image",
    "crawler",
    "downloader",
    "scraper"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.0.0",
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "cross-spawn": "^7.0.3",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.2.10",
    "playwright": "^1.55.1",
    "progress": "^2.0.3",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^20.8.10",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.0.2",
    "prettier": "^3.1.0",
    "uuid": "^11.0.0"
  },
  "optionalDependencies": {
    "windows-drive-letters": "^1.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
